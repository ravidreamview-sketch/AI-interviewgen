# ==============================================================================
# RAVI GENAI STUDIO — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure your environment-specific values.
# ==============================================================================

# 1. AI Question Synthesis API Keys
# Gemini API Key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Groq API Key (Fallback LLM): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 2. Database Connection URL
# Local Development: Leave blank to use local SQLite (./interview.db)
# Production (Vercel / AWS / Docker): Set to managed PostgreSQL (Supabase, Neon, AWS RDS)
# Example: postgresql://postgres:password@db.supabase.co:5432/postgres
DATABASE_URL=

# 3. Super Admin & JWT Security
# Cryptographic secret used to sign session tokens (min 32 random characters in production)
ADMIN_JWT_SECRET=your_32_char_random_jwt_secret_key_here
# Token expiration time in minutes (default: 480 min = 8 hours)
ADMIN_TOKEN_EXPIRE_MINUTES=480

# Initial Super Admin bootstrap credentials (used on first initialization if no super admin exists)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=your_super_admin_secure_password_here

# 4. CORS Allowed Origins (Comma-separated list of trusted frontend domains)
# Example: http://localhost:8000,http://127.0.0.1:8000,https://ravi-genai-studio.vercel.app
ADMIN_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# 5. Environment Mode
# Set to 'production' on production deployments to enforce strict HTTPS cookies and security checks
ENV=development