{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": "app/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/health", "destination": "/api/index.py" },
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/generate", "destination": "/api/index.py" },
    { "source": "/docs", "destination": "/api/index.py" },
    { "source": "/openapi.json", "destination": "/api/index.py" },
    { "source": "/public/:path*", "destination": "/api/index.py" },
    { "source": "/history", "destination": "/api/index.py" },
    { "source": "/history/:path*", "destination": "/api/index.py" },
    { "source": "/candidate/logout", "destination": "/api/index.py" },
    { "source": "/logout", "destination": "/api/index.py" },
    { "source": "/debug-status", "destination": "/api/index.py" },
    { "source": "/candidate/login", "destination": "/Candidate-login.html" },
    { "source": "/login", "destination": "/Candidate-login.html" },
    { "source": "/Login.html", "destination": "/Login.html" },
    { "source": "/Candidate-login.html", "destination": "/Candidate-login.html" },
    { "source": "/candidate/interview-studio", "destination": "/Interview-studio.html" },
    { "source": "/candidate/mock-interview", "destination": "/Mock-interview.html" },
    { "source": "/candidate/dashboard", "destination": "/Candidate-dashboard.html" },
    { "source": "/dashboard", "destination": "/Candidate-dashboard.html" },
    { "source": "/candidate/resume-jd-match", "destination": "/Resume-match.html" },
    { "source": "/candidate/resume-match", "destination": "/Resume-match.html" },
    { "source": "/resume-match", "destination": "/Resume-match.html" },
    { "source": "/Resume-match.html", "destination": "/Resume-match.html" },
    { "source": "/candidate/company-playbooks", "destination": "/Company-playbooks.html" },
    { "source": "/company-playbooks", "destination": "/Company-playbooks.html" },
    { "source": "/candidate/history", "destination": "/Interview history.html" },
    { "source": "/candidate/upgrade-pro", "destination": "/Upgrade-pro.html" },
    { "source": "/upgrade-pro", "destination": "/Upgrade-pro.html" },
    { "source": "/candidate/user-guide", "destination": "/User-guide.html" },
    { "source": "/user-guide", "destination": "/User-guide.html" },
    { "source": "/candidate/scorecard", "destination": "/scorecard.html" },
    { "source": "/scorecard", "destination": "/scorecard.html" },
    { "source": "/scorecard/:path*", "destination": "/scorecard.html" },
    { "source": "/admin/dashboard", "destination": "/Admin.html" },
    { "source": "/admin/menu-management", "destination": "/Admin.html" },
    { "source": "/admin/users", "destination": "/Admin.html" },
    { "source": "/admin/roles-permissions", "destination": "/Admin.html" },
    { "source": "/admin/prompts", "destination": "/Admin.html" },
    { "source": "/admin/login", "destination": "/Admin.html" },
    { "source": "/admin", "destination": "/Admin.html" },
    { "source": "/analytics", "destination": "/Analytics.html" },
    { "source": "/Analytics", "destination": "/Analytics.html" },
    { "source": "/candidate/:path*", "destination": "/Interview-studio.html" },
    { "source": "/", "destination": "/Candidate-login.html" }
  ]
}
