{
  "version": 2,
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "logo.png",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/generate",
      "dest": "app/main.py"
    },
    {
      "src": "/history(.*)",
      "dest": "app/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
